{
  "meta": {
    "title": "Enquête courte — Location de bennes et transport de déchets BTP en Guyane",
    "intro": [
      { "type": "paragraph", "text": "La Cellule Économique Régionale de la Construction de Guyane réalise une enquête courte sur les prestations de bennes à déchets destinées aux chantiers du BTP :" },
      { "type": "list", "items": ["Location", "Transport", "Rotation", "Évacuation des déchets"] },
      { "type": "paragraph", "text": "Les résultats seront exploités uniquement sous forme agrégée. Aucune donnée ne sera publiée par entreprise, client, chantier ou site." },
      { "type": "paragraph", "text": "Merci de répondre au regard de votre activité habituelle au **cours des 12 derniers mois**." }
    ],
    "estimated_duration_min": "5-8",
    "sheet_name": "Reponses"
  },
  "sections": [
    { "id": "A", "title": "Filtre d'accès" },
    { "id": "B", "title": "Votre entreprise" },
    { "id": "C", "title": "Détail du parc" },
    { "id": "D", "title": "Pratiques de transport" },
    { "id": "E", "title": "Location de bennes" },
    { "id": "F", "title": "Logistique et rotation" },
    { "id": "G", "title": "Freins et difficultés" }
  ],
  "questions": [
    { "id": "q1_activite", "section": "A", "label": "Votre entreprise propose-t-elle la location de bennes et/ou le transport de déchets pour des entreprises ou chantiers BTP ?", "type": "radio", "required": true, "options": ["Oui", "Non"], "columns": ["q1_activite"] },
    { "id": "q2_denomination", "section": "B", "label": "Dénomination entreprise", "type": "text", "required": true, "columns": ["q2_denomination"] },
    { "id": "q4_email", "section": "B", "label": "E-mail de contact", "helper": "Adresse à usage professionnel.", "type": "email", "required": true, "columns": ["q4_email"], "extra_field": { "id": "q4_telephone", "label": "Téléphone", "type": "tel", "required": false, "placeholder": "0000000000", "column": "q4_telephone" } },
    { "id": "q5_prestations", "section": "B", "label": "Quelles prestations liées à la gestion des déchets BTP proposez-vous ?", "type": "checkbox", "required": true, "allow_other": true, "options": ["Location de bennes", "Livraison et enlèvement de bennes", "Transport de déchets", "Location de véhicule avec chauffeur", "Tri, transit ou traitement des déchets"], "columns": ["q5_prestations"], "export_join": "; " },
    { "id": "q6_territoires", "section": "B", "label": "Sur quels territoires intervenez-vous ?", "type": "checkbox", "required": true, "options": ["CACL", "CCDS", "CCDS (Saint-Élie)", "CCEG (Régina-Kaw/Saint-Georges)", "CCEG (Ouanary/Camopi)", "CCOG (Mana/Awala-Yalimapo/Saint-Laurent/Apatou)", "CCOG (communes du fleuve Maroni)", "CCOG (Saül)"], "columns": ["q6_territoires"], "export_join": "; " },
    { "id": "q7_parc_vehicules", "section": "C", "label": "Disposez-vous d'un parc de véhicules ?", "type": "radio", "required": true, "options": ["Oui", "Non"], "columns": ["q7_parc_vehicules"] },
    { "id": "q8_parc_detail", "section": "C", "label": "Indiquez le nombre de véhicules (dédiés au transport de bennes) dont vous disposez, par type :", "type": "matrix_single", "required": true, "rows": ["Camion polybenne", "Camion ampliroll", "Camion-benne", "Semi-remorque"], "row_keys": ["polybenne", "ampliroll", "benne", "semi_remorque"], "options": ["0", "1", "2", "3", "4", "5", "Plus de 5"], "columns": ["q8_polybenne", "q8_ampliroll", "q8_benne", "q8_semi_remorque"], "visible_if": { "question": "q7_parc_vehicules", "equals": "Oui" } },
    { "id": "q9_age_moyen", "section": "C", "label": "Quel est l'âge moyen de ces véhicules ?", "type": "radio", "display": "chips", "required": false, "options": ["Moins de 3 ans", "De 3 à 5 ans", "De 6 à 10 ans", "Plus de 10 ans", "Parc très hétérogène", "Ne souhaite pas répondre"], "columns": ["q9_age_moyen"], "visible_if": { "question": "q7_parc_vehicules", "equals": "Oui" } },
    { "id": "q10_km_moyen", "section": "C", "label": "En 2025, combien de kilomètres en moyenne, avez-vous parcouru avec ces véhicules ?", "helper": "Indiquez une estimation en kilomètres pour chaque type de véhicule concerné. Laissez vide si vous n'en disposez pas.", "type": "matrix_number", "required": true, "rows": ["Camion polybenne", "Camion ampliroll", "Camion-benne", "Semi-remorque"], "row_keys": ["polybenne", "ampliroll", "benne", "semi_remorque"], "columns": ["q10_km_polybenne", "q10_km_ampliroll", "q10_km_benne", "q10_km_semi_remorque"], "allow_na": true, "na_label": "Ne souhaite pas répondre", "na_column": "q10_km_nsp", "visible_if": { "question": "q7_parc_vehicules", "equals": "Oui" } },
    { "id": "q11_sous_traitance", "section": "D", "label": "Avez-vous recours à de la sous-traitance pour le transport de bennes à déchets ?", "type": "radio", "required": true, "options": ["Oui, via une entité de notre groupe/filiale", "Oui, via un prestataire externe", "Non"], "columns": ["q11_sous_traitance"] },
    { "id": "q12_tarif_rotation", "section": "D", "label": "Quel est le tarif moyen d'une rotation (apport/enlèvement/livraison exutoire) ?", "helper": "Indiquer un montant en euros H.T.", "type": "number", "required": false, "columns": ["q12_tarif_rotation"] },
    { "id": "q13_part_activite_transport", "section": "D", "label": "Quelle part approximative représente l'activité BTP de transport de bennes à déchets ?", "type": "radio", "required": true, "options": ["Moins de 25%", "De 25% à moins de 50%", "50% à moins de 75%", "75% ou plus", "Ne souhaite pas répondre"], "columns": ["q13_part_activite_transport"] },
    { "id": "q14_bennes_detail", "section": "E", "label": "Combien de bennes à déchets possédez-vous, par volume ?", "type": "matrix_single", "required": true, "rows": ["3 m³", "6 m³", "8 m³", "10 m³", "12 m³", "15 m³", "20 m³", "30 m³", "Plus de 30 m³"], "row_keys": ["3m3", "6m3", "8m3", "10m3", "12m3", "15m3", "20m3", "30m3", "plus30m3"], "options": ["0", "1 à 3", "4 à 9", "10 à 29", "30 à 99", "100 et plus", "Ne souhaite pas répondre"], "columns": ["q14_bennes_3m3", "q14_bennes_6m3", "q14_bennes_8m3", "q14_bennes_10m3", "q14_bennes_12m3", "q14_bennes_15m3", "q14_bennes_20m3", "q14_bennes_30m3", "q14_bennes_plus30m3"] },
    { "id": "q15_base_facturation", "section": "E", "label": "Sur quelle base facturez-vous la mise en location d'une benne ?", "type": "radio", "required": true, "allow_other": true, "options": ["À la journée", "À la semaine", "Au mois", "Forfait chantier", "Prestation globale"], "columns": ["q15_base_facturation"] },
    { "id": "q16_tarif_benne_8m3", "section": "E", "label": "Quel est le tarif moyen pour la mise à disposition d'une benne de 8 m³ ?", "helper": "Indiquer un montant en euros H.T.", "type": "number", "required": false, "illustration": "benne_8m3", "columns": ["q16_tarif_benne_8m3"] },
    { "id": "q17_inclus_tarif", "section": "E", "label": "Les éléments suivants sont-ils inclus dans le tarif de location de bennes ?", "type": "matrix_single", "required": true, "rows": ["La livraison ou le dépôt d'une benne vide sur site ou chantier", "L'enlèvement d'une benne pleine du site ou chantier", "L'acheminement d'une benne pleine jusqu'à un exutoire"], "row_keys": ["livraison", "enlevement", "acheminement_exutoire"], "options": ["Oui", "Non"], "columns": ["q17_inclus_livraison", "q17_inclus_enlevement", "q17_inclus_acheminement_exutoire"] },
    { "id": "q18_conditions_multi_bennes", "section": "E", "label": "Proposez-vous des conditions particulières lorsque plusieurs bennes sont louées pour un même chantier ?", "type": "radio", "required": false, "options": ["Oui, de manière standardisée", "Oui, au cas par cas", "Non", "Ne souhaite pas répondre"], "columns": ["q18_conditions_multi_bennes"] },
    { "id": "q19_flux_dechets", "section": "E", "label": "Quels flux sont le plus souvent pris en charge ?", "type": "checkbox", "required": false, "allow_other": true, "options": ["Terres et déblais", "Gravats (béton, brique...)", "Déchets de chantier mélangés", "Bois", "Métaux/ferrailles", "Papiers/cartons/plastiques", "Plâtre", "Déchets verts", "Déchets dangereux"], "columns": ["q19_flux_dechets"], "export_join": "; " },
    { "id": "q20_sous_location", "section": "E", "label": "Avez-vous recours à la sous-location pour compléter votre parc de bennes ?", "type": "radio", "required": true, "options": ["Oui", "Non"], "columns": ["q20_sous_location"] },
    { "id": "q21_part_activite_location", "section": "E", "label": "Quelle part approximative représente l'activité de location de bennes pour le BTP dans votre activité globale ?", "type": "radio", "required": true, "options": ["Moins de 25%", "25% à moins de 50%", "50% à moins de 75%", "75% ou plus", "Ne souhaite pas répondre"], "columns": ["q21_part_activite_location"] },
    { "id": "q22_declencheur_rotation", "section": "F", "label": "Quel est le principal déclencheur d'une rotation ou d'un enlèvement de benne ?", "type": "radio", "required": true, "allow_other": true, "options": ["Demande du client", "Planning convenu", "Durée de mise à disposition"], "columns": ["q22_declencheur_rotation"] },
    { "id": "q23_delai_intervention", "section": "F", "label": "Quel est votre délai moyen d'intervention pour livrer une benne sur chantier (hors période exceptionnelle) ?", "type": "radio", "required": false, "options": ["Le jour même", "Sous 24 heures", "Sous 48 heures", "Sous 3 à 5 jours", "Plus de 5 jours", "Variable selon le type de benne ou la zone"], "columns": ["q23_delai_intervention"] },
    { "id": "q24_reemploi_bennes", "section": "F", "label": "Vos bennes sont-elles réemployables après chaque rotation ?", "type": "radio", "required": false, "options": ["Oui, immédiatement", "Oui, après un bref nettoyage", "Non, il faut un traitement spécifique", "Ne peut pas répondre"], "columns": ["q24_reemploi_bennes"] },
    { "id": "q25_difficultes", "section": "G", "label": "Rencontrez-vous des difficultés de disponibilité des bennes, de transports ou d'accès aux exutoires ?", "type": "matrix_single", "required": true, "rows": ["Disponibilité des bennes", "Transport (véhicules et chauffeurs)", "Accès aux exutoires"], "row_keys": ["disponibilite_bennes", "transport", "acces_exutoires"], "options": ["Souvent", "Parfois", "Rarement", "Jamais"], "columns": ["q25_freq_disponibilite_bennes", "q25_freq_transport", "q25_freq_acces_exutoires"] },
    { "id": "q26_freins_precisions", "section": "G", "label": "Précisez les éventuels freins rencontrés :", "type": "checkbox", "required": false, "allow_other": true, "options": ["Manque de disponibilité des bennes", "Manque de véhicules de transport", "Pénurie de main-d'œuvre / chauffeurs", "Distances importantes / éloignement", "Accès complexes aux chantiers", "Saturation ou problèmes d'accès aux exutoires", "Coûts d'exploitation trop élevés", "Difficultés d'approvisionnement en matériel"], "columns": ["q26_freins_precisions"], "export_join": "; " }
  ],
  "logic_rules": [
    { "id": "rule_q1_non", "if": { "question": "q1_activite", "equals": "Non" }, "then": { "action": "goto_end" } },
    { "id": "rule_q7_non", "if": { "question": "q7_parc_vehicules", "equals": "Non" }, "then": { "action": "skip_to", "target": "q11_sous_traitance" } }
  ],
  "end_screen": {
    "message": "La CERC Guyane vous remercie pour l'intérêt porté à cette enquête. Vous pouvez transférer ce formulaire aux personnes susceptibles de pouvoir y répondre.",
    "share_action": "copy_link"
  }
}
